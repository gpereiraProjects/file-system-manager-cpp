{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "description": "Debug build using Ninja and the active C++ toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FILE_SYSTEM_MANAGER_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "description": "Optimized release build using Ninja and the active C++ toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FILE_SYSTEM_MANAGER_WARNINGS_AS_ERRORS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "jobs": 0
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 0
    }
  ]
}
